<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>g17_prii3_turtlesim</name>

  <version>0.0.0</version>

  <description>
    Paquete ROS 2 del grupo 17 para controlar turtlesim y dibujar el numero 17.
  </description>

  <maintainer email="alejandro@todo.todo">
    alejandrossalido
  </maintainer>

  <license>TODO: License declaration</license>


  <!-- Dependencias del nodo Python -->

  <depend>rclpy</depend>

  <depend>geometry_msgs</depend>

  <depend>turtlesim</depend>

  <depend>std_srvs</depend>


  <!-- Dependencias necesarias para ros2 launch -->

  <exec_depend>launch</exec_depend>

  <exec_depend>launch_ros</exec_depend>


  <!-- Dependencias de test -->

  <test_depend>ament_copyright</test_depend>

  <test_depend>ament_flake8</test_depend>

  <test_depend>ament_pep257</test_depend>

  <test_depend>python3-pytest</test_depend>


  <export>

    <build_type>ament_python</build_type>

  </export>

</package>
